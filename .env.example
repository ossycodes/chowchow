# Copy to .env for local development: cp .env.example .env

NODE_ENV=development
LOG_LEVEL=debug

# --- Datastores (match infra/docker-compose.yml) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root

# Per-service connection strings (one database per service).
IDENTITY_DATABASE_URL=mysql://root:root@localhost:3306/chowdeck_identity
CATALOG_DATABASE_URL=mysql://root:root@localhost:3306/chowdeck_catalog
ORDER_DATABASE_URL=mysql://root:root@localhost:3306/chowdeck_order
DISPATCH_DATABASE_URL=mysql://root:root@localhost:3306/chowdeck_dispatch
PAYMENTS_DATABASE_URL=mysql://root:root@localhost:3306/chowdeck_payments
LEDGER_DATABASE_URL=mysql://root:root@localhost:3306/chowdeck_ledger

REDIS_URL=redis://localhost:6379

# --- Kafka (Redpanda) ---
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=chowdeck
# Set to "true" to actually connect to Kafka (needs `pnpm infra:up`).
# When unset/false, services use in-memory adapters (no infra required).
KAFKA_ENABLED=false

# --- Auth ---
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# --- Service ports ---
GATEWAY_PORT=3000
IDENTITY_HTTP_PORT=3001
NOTIFICATIONS_HTTP_PORT=3002
CATALOG_HTTP_PORT=3003
ORDER_HTTP_PORT=3004
DISPATCH_HTTP_PORT=3005
PAYMENTS_HTTP_PORT=3006
LEDGER_HTTP_PORT=3007

# Internal gRPC (service-to-service). catalog BINDS this; order DIALS it.
# localhost works for both on a single dev host. In prod, split them: catalog binds
# 0.0.0.0:50051, order dials the catalog service's DNS name.
CATALOG_GRPC_URL=localhost:50051

# --- Gateway routing (where the gateway forwards to) ---
IDENTITY_URL=http://localhost:3001
NOTIFICATIONS_URL=http://localhost:3002
CATALOG_URL=http://localhost:3003
ORDER_URL=http://localhost:3004
DISPATCH_URL=http://localhost:3005
PAYMENTS_URL=http://localhost:3006
LEDGER_URL=http://localhost:3007
CORS_ORIGIN=*

# --- Payments (Nigeria) — sandbox keys, never commit real ones ---
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
